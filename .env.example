# 复制为 .env 后按需修改。留空表示用默认值（SQLite，数据在 ./data）。
SATCHEL_IMAGE=ghcr.io/tajiaoyezi/satchel:latest

# 用 PostgreSQL 时填这些（docker compose --profile postgres up -d 起本机的 PostgreSQL 后，HOST 填 127.0.0.1）
SATCHEL_DATABASE_DRIVER=
SATCHEL_DATABASE_HOST=
SATCHEL_DATABASE_PORT=
SATCHEL_DATABASE_NAME=
SATCHEL_DATABASE_USER=
SATCHEL_DATABASE_PASSWORD=
SATCHEL_DATABASE_SSLMODE=

# postgres profile 的初始化参数
POSTGRES_DB=satchel
POSTGRES_USER=satchel
POSTGRES_PASSWORD=change-me-before-start
